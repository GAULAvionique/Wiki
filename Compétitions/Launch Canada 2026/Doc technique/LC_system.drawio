        <mxCell id="5or_3En5fItqHwZpVwx8-174" parent="5or_3En5fItqHwZpVwx8-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;Molex MicroFit 3.0&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;vertical&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;plug&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;2x2 pins&lt;/font&gt;&lt;/div&gt;" vertex="1">
